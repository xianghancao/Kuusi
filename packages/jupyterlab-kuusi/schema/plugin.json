{
  "title": "jupyterlab-kuusi",
  "description": "jupyterlab-kuusi settings.",
  "jupyter.lab.toolbars": {
    "Notebook": [
      {
        "name": "open-mindmap",
        "command": "jupyterlab-kuusi:open-notebook-mindmap",
        "label": "Kuusi",
        "rank": 41
      },
      {
        "name": "kuusi-notebook-auto-reload",
        "rank": 42
      }
    ],
    "Kuusi Mind Map": [
      { "name": "save", "rank": 10 },
      { "name": "insert", "rank": 20 },
      { "name": "cut", "rank": 21 },
      { "name": "copy", "rank": 22 },
      { "name": "paste", "rank": 23 },
      { "name": "run", "rank": 30 },
      { "name": "interrupt", "rank": 31 },
      { "name": "restart", "rank": 32 },
      { "name": "restart-and-run", "rank": 33 },
      { "name": "cellType", "rank": 40 },
      {
        "name": "open-notebook",
        "command": "jupyterlab-kuusi:open-notebook-view",
        "label": "Notebook",
        "rank": 41
      },
      {
        "name": "kuusi-notebook-auto-reload",
        "rank": 42
      },
      { "name": "spacer", "type": "spacer", "rank": 100 },
      { "name": "kernelName", "rank": 1000 },
      { "name": "executionProgress", "rank": 1002 }
    ]
  },
  "jupyter.lab.transform": true,
  "type": "object",
  "properties": {
    "toolbar": {
      "title": "Kuusi mind map toolbar items",
      "description": "Note: To disable a toolbar item,\ncopy it to User Preferences and add the\n\"disabled\" key.",
      "items": {
        "$ref": "#/definitions/toolbarItem"
      },
      "type": "array",
      "default": []
    },
    "theme": {
      "title": "Mind map theme",
      "description": "Named preset that applies Line, Node, Background, and Font settings together.",
      "type": "string",
      "enum": [
        "notebook",
        "soft",
        "outline",
        "paper",
        "board",
        "black",
        "minimal"
      ],
      "default": "notebook"
    },
    "font": {
      "title": "Mind map font (legacy)",
      "description": "Deprecated. Migrates to editFont and displayFont.",
      "type": "string",
      "enum": [
        "notebook",
        "system-ui",
        "arial",
        "helvetica",
        "segoe-ui",
        "verdana",
        "georgia",
        "times",
        "palatino",
        "garamond",
        "cambria"
      ],
      "default": "notebook"
    },
    "editFont": {
      "title": "Mind map edit font",
      "description": "Font family while editing cell source (before render).",
      "type": "string",
      "enum": [
        "notebook",
        "system-ui",
        "arial",
        "helvetica",
        "segoe-ui",
        "verdana",
        "georgia",
        "times",
        "palatino",
        "garamond",
        "cambria"
      ],
      "default": "notebook"
    },
    "displayFont": {
      "title": "Mind map display font",
      "description": "Font family for rendered markdown/HTML output.",
      "type": "string",
      "enum": [
        "notebook",
        "system-ui",
        "arial",
        "helvetica",
        "segoe-ui",
        "verdana",
        "georgia",
        "times",
        "palatino",
        "garamond",
        "cambria"
      ],
      "default": "notebook"
    },
    "editFontSize": {
      "title": "Mind map edit font size",
      "description": "Font size while editing cell source (before render).",
      "type": "string",
      "enum": ["xxs", "xs", "sm", "md", "lg", "xl", "xxl"],
      "default": "md"
    },
    "displayFontSize": {
      "title": "Mind map display font size",
      "description": "Font size for rendered markdown/HTML output.",
      "type": "string",
      "enum": ["xxs", "xs", "sm", "md", "lg", "xl", "xxl"],
      "default": "md"
    },
    "unifyEditDisplayFont": {
      "title": "Unify edit and display fonts",
      "description": "Keep edit and display font family and size the same.",
      "type": "boolean",
      "default": false
    },
    "matchNotebookFont": {
      "title": "Match notebook fonts",
      "description": "Use the same font family as the classic notebook (ipynb).",
      "type": "boolean",
      "default": false
    },
    "layoutDensity": {
      "title": "Node layout spacing",
      "type": "string",
      "enum": ["compact", "normal", "loose"],
      "default": "normal"
    },
    "siblingGap": {
      "title": "Sibling node boundary gap",
      "description": "Boundary distance between sibling nodes in the mind map layout.",
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 22
    },
    "childGap": {
      "title": "Child node boundary gap",
      "description": "Boundary distance between parent and child nodes in the mind map layout.",
      "type": "number",
      "minimum": 0,
      "maximum": 400,
      "default": 52
    },
    "equalNodeWidth": {
      "title": "Equal width",
      "description": "When true, every mind map node uses the same width. When false, nodes can be resized individually.",
      "type": "boolean",
      "default": false
    },
    "adaptiveNodeWidth": {
      "title": "Fit content",
      "description": "When true, node width follows content (capped by Node width). With Equal width, all nodes share the widest content width, still capped.",
      "type": "boolean",
      "default": false
    },
    "nodeWidth": {
      "title": "Node width",
      "description": "Default mind map node width in pixels. When Fit content is on, this is the maximum width.",
      "type": "number",
      "minimum": 160,
      "maximum": 960,
      "default": 700
    },
    "treeDirection": {
      "title": "Tree direction",
      "type": "string",
      "enum": ["TB", "BT", "LR", "RL"],
      "default": "LR"
    },
    "background": {
      "title": "Canvas background color",
      "type": "string",
      "enum": [
        "default",
        "business-blue",
        "eye-care",
        "newspaper",
        "sea-blue",
        "tech-blue",
        "grass-green",
        "avocado",
        "stone-gray",
        "red-wall",
        "ink",
        "custom"
      ],
      "default": "default"
    },
    "backgroundPattern": {
      "title": "Canvas background pattern",
      "type": "string",
      "enum": ["none", "plain", "grid", "grid-dense", "dots", "dots-dense", "gradient"],
      "default": "none"
    },
    "backgroundColor": {
      "title": "Custom canvas background color",
      "type": "string",
      "default": "#d6ecff"
    },
    "showUpdatedTimestamp": {
      "title": "Show mind map updated time",
      "description": "Display the notebook file last-modified time in the bottom-left corner of the mind map.",
      "type": "boolean",
      "default": true
    },
    "appearance": {
      "title": "Line and node appearance",
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "edgeStyle": {
          "type": "string",
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "long-dash",
            "dash-dot",
            "dense-dot",
            "sparse-dash"
          ],
          "default": "solid"
        },
        "edgeRoute": {
          "type": "string",
          "title": "Edge route",
          "description": "How connectors bend between parent and child nodes.",
          "enum": [
            "straight",
            "curve",
            "orthogonal",
            "rounded-orthogonal"
          ],
          "default": "orthogonal"
        },
        "edgeArrowDirection": {
          "type": "string",
          "enum": ["none", "end", "start", "both"],
          "default": "none"
        },
        "edgeArrowStyle": {
          "type": "string",
          "enum": ["triangle", "stealth", "diamond", "circle", "open"],
          "default": "triangle"
        },
        "edgeWidth": {
          "type": "string",
          "default": "3pt"
        },
        "edgeColor": {
          "type": "string",
          "default": ""
        },
        "nodeFillColor": {
          "type": "string",
          "title": "Map node fill",
          "description": "Default fill for mind map nodes. Empty uses the theme. Per-node overrides use cell metadata.",
          "default": ""
        },
        "nodeBorderStyle": {
          "type": "string",
          "enum": ["solid", "dashed", "dotted"],
          "default": "solid"
        },
        "nodeBorderWidth": {
          "type": "string",
          "default": "1px"
        },
        "nodeBorderColor": {
          "type": "string",
          "default": ""
        },
        "nodeBorderCorner": {
          "type": "string",
          "enum": ["sharp", "rounded", "ellipse"],
          "default": "rounded"
        },
        "nodeBorderRadius": {
          "type": "string",
          "default": "8px"
        },
        "selectionGlowColor": {
          "type": "string",
          "title": "Selection glow color",
          "description": "Glow color for the selected mind map node. Empty uses the theme brand color.",
          "default": ""
        },
        "selectionGlowWidth": {
          "type": "string",
          "title": "Selection glow width",
          "description": "Glow ring width for the selected mind map node.",
          "default": "2px"
        },
        "hoverGlowColor": {
          "type": "string",
          "title": "Hover glow color",
          "description": "Edge glow when the pointer is over a mind map node. Empty follows the map node border color when set; otherwise blue (#1976d2).",
          "default": ""
        },
        "hoverGlowWidth": {
          "type": "string",
          "title": "Hover glow width",
          "description": "Glow ring and soft halo size when hovering a mind map node (same presets as node border width).",
          "default": "1px"
        }
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "toolbarItem": {
      "properties": {
        "name": {
          "title": "Unique name",
          "type": "string"
        },
        "args": {
          "title": "Command arguments",
          "type": "object"
        },
        "command": {
          "title": "Command id",
          "type": "string",
          "default": ""
        },
        "disabled": {
          "title": "Whether the item is ignored or not",
          "type": "boolean",
          "default": false
        },
        "icon": {
          "title": "Item icon id",
          "description": "If defined, it will override the command icon",
          "type": "string"
        },
        "label": {
          "title": "Item label",
          "description": "If defined, it will override the command label",
          "type": "string"
        },
        "caption": {
          "title": "Item caption",
          "description": "If defined, it will override the command caption",
          "type": "string"
        },
        "type": {
          "title": "Item type",
          "type": "string",
          "enum": ["command", "spacer"]
        },
        "rank": {
          "title": "Item rank",
          "type": "number",
          "minimum": 0,
          "default": 50
        }
      },
      "required": ["name"],
      "additionalProperties": false,
      "type": "object"
    }
  }
}
