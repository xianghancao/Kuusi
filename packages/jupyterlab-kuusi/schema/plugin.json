  "jupyter.lab.transform": true,
  "type": "object",
  "properties": {
    "toolbar": {
      "title": "Kuusi mind map toolbar items",
      "description": "Note: To disable a toolbar item,\ncopy it to User Preferences and add the\n\"disabled\" key.",
      "items": {
        "$ref": "#/definitions/toolbarItem"
      },
      "type": "array",
      "default": []
    },
    "theme": {
      "title": "Mind map theme",
      "description": "Named preset that applies Line, Node, Background, and Font settings together.",
      "type": "string",
      "enum": [
        "notebook",
        "soft",
        "outline",
        "paper",
        "board",
        "black",
        "minimal"
      ],
      "default": "notebook"
    },
    "font": {
      "type": "string",
      "enum": [
        "notebook",
        "system-ui",
        "arial",
        "helvetica",
        "segoe-ui",
        "verdana",
        "georgia",
        "times",
        "palatino",
        "garamond",
        "cambria",
        "songti",
        "heiti",
        "kaiti",
        "fangsong"
      ],
      "default": "notebook",
      "title": "Mind map body font",
      "description": "Font family for Body nodes."
    },
    "editFont": {
      "title": "Mind map edit font",
      "description": "Font family while editing cell source (before render).",
      "type": "string",
      "enum": [
        "notebook",
        "system-ui",
        "arial",
        "helvetica",
        "segoe-ui",
        "verdana",
        "georgia",
        "times",
        "palatino",
        "garamond",
        "cambria",
        "songti",
        "heiti",
        "kaiti",
        "fangsong"
      ],
      "default": "notebook"
    },
    "displayFont": {
      "title": "Mind map display font",
      "description": "Font family for rendered markdown/HTML output.",
      "type": "string",
      "enum": [
        "notebook",
        "system-ui",
        "arial",
        "helvetica",
        "segoe-ui",
        "verdana",
        "georgia",
        "times",
        "palatino",
        "garamond",
        "cambria",
        "songti",
        "heiti",
        "kaiti",
        "fangsong"
      ],
      "default": "notebook"
    },
    "editFontSize": {
      "title": "Mind map edit font size",
      "description": "Body size while editing cell source, in CSS px (8–16).",
      "type": "number",
      "minimum": 8,
      "maximum": 37.5,
      "default": 14
    },
    "displayFontSize": {
      "title": "Mind map display font size",
      "description": "Body size for rendered markdown/HTML output, in CSS px (8–16).",
      "type": "number",
      "minimum": 8,
      "maximum": 37.5,
      "default": 14
    },
    "unifyEditDisplayFont": {
      "title": "Unify edit and display fonts",
      "description": "Keep edit and display font family and size the same.",
      "type": "boolean",
      "default": false
    },
    "matchNotebookFont": {
      "title": "Match notebook fonts",
      "description": "Use the same font family as the classic notebook (ipynb).",
      "type": "boolean",
      "default": false
    },
    "color": {
      "type": "string",
      "default": "",
      "title": "Mind map body color",
      "description": "Body text color. Empty follows the node foreground."
    },
    "letterSpacing": {
      "type": "number",
      "minimum": 0,
      "maximum": 3,
      "default": 0,
      "title": "Mind map letter spacing",
      "description": "Tracking for Body nodes, in pt (0–3)."
    },
    "lineHeight": {
      "type": "number",
      "minimum": 0.9,
      "maximum": 2.4,
      "default": 1.5,
      "title": "Mind map leading",
      "description": "Line-height multiplier for Body nodes (0.9–2.4)."
    },
    "paragraphSpacing": {
      "type": "number",
      "minimum": 0,
      "maximum": 48,
      "default": 0.5,
      "title": "Mind map paragraph spacing",
      "description": "Vertical space between paragraphs inside a node, in pt (0–48)."
    },
    "paragraphIndent": {
      "type": "number",
      "minimum": 0,
      "maximum": 72,
      "default": 0,
      "title": "Mind map paragraph indent",
      "description": "First-line indent inside Body nodes, in pt (0–72)."
    },
    "paragraphAlign": {
      "type": "string",
      "enum": [
        "left",
        "justify"
      ],
      "default": "left",
      "title": "Mind map paragraph alignment"
    },
    "linkStyle": {
      "type": "string",
      "enum": [
        "default",
        "underline",
        "accent"
      ],
      "default": "default",
      "title": "Mind map link style"
    },
    "headers": {
      "type": "object",
      "properties": {
        "h1": {
          "$ref": "#/definitions/headerStyle"
        },
        "h2": {
          "$ref": "#/definitions/headerStyle"
        },
        "h3": {
          "$ref": "#/definitions/headerStyle"
        },
        "h4": {
          "$ref": "#/definitions/headerStyle"
        },
        "h5": {
          "$ref": "#/definitions/headerStyle"
        },
        "h6": {
          "$ref": "#/definitions/headerStyle"
        }
      },
      "additionalProperties": false,
      "default": {
        "h1": {
          "font": "notebook",
          "fontSize": "md",
          "color": "",
          "align": "left"
        },
        "h2": {
          "font": "notebook",
          "fontSize": "md",
          "color": "",
          "align": "left"
        },
        "h3": {
          "font": "notebook",
          "fontSize": "md",
          "color": "",
          "align": "left"
        },
        "h4": {
          "font": "notebook",
          "fontSize": "md",
          "color": "",
          "align": "left"
        },
        "h5": {
          "font": "notebook",
          "fontSize": "md",
          "color": "",
          "align": "left"
        },
        "h6": {
          "font": "notebook",
          "fontSize": "md",
          "color": "",
          "align": "left"
        }
      },
      "title": "Mind map headings",
      "description": "H1–H3 style tree frames. H4–H6 style titles inside a card. Defaults match Body so existing maps do not jump."
    },
    "codeStyle": {
      "type": "string",
      "enum": [
        "plain",
        "muted",
        "contrast"
      ],
      "default": "muted",
      "title": "Mind map code style",
      "description": "Appearance of inline code and fenced code blocks inside nodes."
    },
    "codeTheme": {
      "type": "string",
      "enum": [
        "notebook",
        "python",
        "javascript",
        "r",
        "julia",
        "sql",
        "rust",
        "matlab",
        "shell"
      ],
      "default": "notebook",
      "title": "Mind map code palette",
      "description": "Syntax colors for highlighted code. Notebook follows JupyterLab theme colors."
    },
    "codeFont": {
      "type": "string",
      "enum": [
        "mono",
        "menlo",
        "consolas",
        "monaco",
        "source-code-pro",
        "fira-code",
        "jetbrains-mono",
        "cascadia"
      ],
      "default": "mono",
      "title": "Mind map code font",
      "description": "Monospace face for code inside nodes."
    },
    "codeFontSize": {
      "type": "string",
      "enum": [
        "xxs",
        "xs",
        "sm",
        "md",
        "lg",
        "xl",
        "xxl"
      ],
      "default": "xs",
      "title": "Mind map code font size",
      "description": "Size step for code text."
    },
    "codeFrame": {
      "type": "boolean",
      "title": "Mind map code frame",
      "description": "Draw a border around fenced code blocks inside nodes.",
      "default": false
    },
    "codeFrameColor": {
      "type": "string",
      "default": "",
      "title": "Mind map code frame color",
      "description": "CSS hex color, or empty to follow the node foreground."
    },
    "codeFrameRadius": {
      "type": "number",
      "minimum": 0,
      "maximum": 24,
      "default": 6,
      "title": "Mind map code corner radius",
      "description": "Corner radius of code blocks, in px (0–24)."
    },
    "codeFrameBorder": {
      "type": "number",
      "minimum": 0,
      "maximum": 8,
      "default": 1,
      "title": "Mind map code frame stroke",
      "description": "Border width of the code frame, in px (0–8)."
    },
    "codeFrameWidth": {
      "type": "number",
      "minimum": 40,
      "maximum": 100,
      "default": 100,
      "title": "Mind map code block width",
      "description": "Maximum width of code blocks, as percent of the node (40–100)."
    },
    "tableStyle": {
      "type": "string",
      "enum": [
        "plain",
        "grid",
        "lines",
        "banded",
        "booktabs",
        "ruled"
      ],
      "default": "booktabs",
      "title": "Table style",
      "description": "Word- and LaTeX-inspired table presets (default Booktabs)."
    },
    "tableBorderWidth": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 3,
      "default": 0.75,
      "title": "Table border width",
      "description": "Rule / grid stroke thickness in pt (0.25–3)."
    },
    "tableHeaderRowBold": {
      "type": "boolean",
      "default": true,
      "title": "Bold table header row",
      "description": "Make the first row (column headers) bold."
    },
    "tableHeaderColumnBold": {
      "type": "boolean",
      "default": false,
      "title": "Bold table first column",
      "description": "Make the first column (row headers) bold."
    },
    "listStyle": {
      "type": "string",
      "enum": [
        "compact",
        "normal",
        "relaxed"
      ],
      "default": "normal",
      "title": "List style",
      "description": "Vertical density for unordered and ordered lists."
    },
    "blockquoteWeight": {
      "type": "string",
      "enum": [
        "light",
        "normal",
        "strong"
      ],
      "default": "normal",
      "title": "Blockquote weight",
      "description": "Border and emphasis weight for blockquotes."
    },
    "hrWeight": {
      "type": "string",
      "enum": [
        "light",
        "normal",
        "strong"
      ],
      "default": "normal",
      "title": "Divider weight",
      "description": "Stroke weight for horizontal rules."
    },
    "imageWidth": {
      "type": "string",
      "enum": [
        "natural",
        "wide",
        "full"
      ],
      "default": "wide",
      "title": "Mind map image width",
      "description": "How wide images may grow inside a node."
    },
    "imageAlign": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "center",
      "title": "Mind map image alignment"
    },
    "imageWrap": {
      "type": "string",
      "enum": [
        "none",
        "left",
        "right"
      ],
      "default": "none",
      "title": "Mind map image wrap"
    },
    "imageBorderStyle": {
      "type": "string",
      "enum": [
        "none",
        "solid",
        "dashed",
        "dotted",
        "double"
      ],
      "default": "none",
      "title": "Mind map image border style"
    },
    "imageBorderWidth": {
      "type": "number",
      "minimum": 0,
      "maximum": 12,
      "default": 1,
      "title": "Mind map image border width",
      "description": "Image border thickness in px (0–12)."
    },
    "imageBorderColor": {
      "type": "string",
      "default": "",
      "title": "Mind map image border color",
      "description": "CSS hex color, or empty to follow the node foreground."
    },
    "imageRadius": {
      "type": "number",
      "minimum": 0,
      "maximum": 32,
      "default": 0,
      "title": "Mind map image corner radius",
      "description": "Image corner radius in px (0–32)."
    },
    "layoutDensity": {
      "title": "Node layout spacing",
      "type": "string",
      "enum": [
        "compact",
        "normal",
        "loose"
      ],
      "default": "normal"
    },
    "siblingGap": {
      "title": "Sibling node boundary gap",
      "description": "Boundary distance between sibling nodes in the mind map layout.",
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 22
    },
    "childGap": {
      "title": "Child node boundary gap",
      "description": "Boundary distance between parent and child nodes in the mind map layout.",
      "type": "number",
      "minimum": 0,
      "maximum": 400,
      "default": 52
    },
    "equalNodeWidth": {
      "title": "Equal width",
      "description": "When true, every mind map node uses the same width. When false, nodes can be resized individually.",
      "type": "boolean",
      "default": false
    },
    "adaptiveNodeWidth": {
      "title": "Fit content",
      "description": "When true, node width follows content (capped by Node width). With Equal width, all nodes share the widest content width, still capped.",
      "type": "boolean",
      "default": false
    },
    "nodeWidth": {
      "title": "Node width",
      "description": "Default mind map node width in pixels. When Fit content is on, this is the maximum width.",
      "type": "number",
      "minimum": 160,
      "maximum": 960,
      "default": 700
    },
    "treeDirection": {
      "title": "Tree direction",
      "type": "string",
      "enum": [
        "TB",
        "BT",
        "LR",
        "RL"
      ],
      "default": "LR"
    },
    "background": {
      "title": "Canvas background color",
      "type": "string",
      "enum": [
        "default",
        "business-blue",
        "eye-care",
        "newspaper",
        "sea-blue",
        "tech-blue",
        "grass-green",
        "avocado",
        "stone-gray",
        "red-wall",
        "ink",
        "custom"
      ],
      "default": "default"
    },
    "backgroundPattern": {
      "title": "Canvas background pattern",
      "type": "string",
      "enum": [
        "none",
        "plain",
        "grid",
        "grid-dense",
        "dots",
        "dots-dense",
        "gradient"
      ],
      "default": "none"
    },
    "backgroundColor": {
      "title": "Custom canvas background color",
      "type": "string",
      "default": "#d6ecff"
    },
    "showUpdatedTimestamp": {
      "title": "Show mind map updated time",
      "description": "Display the notebook file last-modified time in the bottom-left corner of the mind map.",
      "type": "boolean",
      "default": true
    },
    "showNodeCount": {
      "title": "Show mind map node count",
      "description": "Display the node count beside zoom in the bottom-right corner.",
      "type": "boolean",
      "default": true
    },
    "showTextCount": {
      "title": "Show character / word count",
      "description": "Display character and word counts beside zoom.",
      "type": "boolean",
      "default": false
    },
    "showPageCount": {
      "title": "Show page count",
      "description": "Display page count beside zoom.",
      "type": "boolean",
      "default": false
    },
    "showFileSize": {
      "title": "Show file size",
      "description": "Display the notebook file size beside zoom.",
      "type": "boolean",
      "default": false
    },
    "appearance": {
      "title": "Line and node appearance",
      "type": "object",
      "default": {},
      "additionalProperties": false,
      "properties": {
        "edgeStyle": {
          "type": "string",
          "enum": [
            "solid",
            "dashed",
            "dotted",
            "long-dash",
            "dash-dot",
            "dense-dot",
            "sparse-dash"
          ],
          "default": "solid"
        },
        "edgeRoute": {
          "type": "string",
          "title": "Edge route",
          "description": "How connectors bend between parent and child nodes.",
          "enum": [
            "straight",
            "curve",
            "orthogonal",
            "rounded-orthogonal"
          ],
          "default": "orthogonal"
        },
        "edgeArrowDirection": {
          "type": "string",
          "enum": [
            "none",
            "end",
            "start",
            "both"
          ],
          "default": "none"
        },
        "edgeArrowStyle": {
          "type": "string",
          "enum": [
            "triangle",
            "stealth",
            "diamond",
            "circle",
            "open"
          ],
          "default": "triangle"
        },
        "edgeWidth": {
          "type": "string",
          "default": "3pt"
        },
        "edgeColor": {
          "type": "string",
          "default": ""
        },
        "edgeTaper": {
          "type": "boolean",
          "title": "Taper lines with depth",
          "description": "Connector lines get thinner toward the leaves.",
          "default": false
        },
        "edgeMinWidth": {
          "type": "string",
          "title": "Minimum line width",
          "description": "Lower bound for tapered connector lines.",
          "default": "1pt"
        },
        "edgeBranchColors": {
          "type": "string",
          "title": "Branch colors",
          "description": "Color each first-level branch's connectors differently.",
          "enum": [
            "off",
            "rainbow",
            "pastel",
            "mono"
          ],
          "default": "off"
        },
        "nodeFillColor": {
          "type": "string",
          "title": "Map node fill",
          "description": "Default fill for mind map nodes. Empty uses the theme. Per-node overrides use cell metadata.",
          "default": ""
        },
        "nodeBorderStyle": {
          "type": "string",
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ],
          "default": "solid"
        },
        "nodeBorderWidth": {
          "type": "string",
          "default": "1px"
        },
        "nodeBorderColor": {
          "type": "string",
          "default": ""
        },
        "nodeBorderCorner": {
          "type": "string",
          "enum": [
            "sharp",
            "rounded",
            "ellipse"
          ],
          "default": "rounded"
        },
        "nodeBorderRadius": {
          "type": "string",
          "default": "8px"
        },
        "selectionGlowColor": {
          "type": "string",
          "title": "Selection glow color",
          "description": "Glow color for the selected mind map node. Empty uses the theme brand color.",
          "default": ""
        },
        "selectionGlowWidth": {
          "type": "string",
          "title": "Selection glow width",
          "description": "Glow ring width for the selected mind map node.",
          "default": "2px"
        },
        "hoverGlowColor": {
          "type": "string",
          "title": "Hover glow color",
          "description": "Edge glow when the pointer is over a mind map node. Empty follows the map node border color when set; otherwise blue (#1976d2).",
          "default": ""
        },
        "hoverGlowWidth": {
          "type": "string",
          "title": "Hover glow width",
          "description": "Glow ring and soft halo size when hovering a mind map node (same presets as node border width).",
          "default": "1px"
        },
        "levelStyles": {
          "type": "object",
          "title": "Per-level node style",
          "description": "Fill and border overrides for the map root, level 1, level 2, and deeper nodes. Empty fields follow the map-wide setting.",
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fill": {
                  "type": "string",
                  "default": ""
                },
                "borderColor": {
                  "type": "string",
                  "default": ""
                },
                "borderWidth": {
                  "type": "string",
                  "default": ""
                },
                "borderRadius": {
